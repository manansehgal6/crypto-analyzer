@startuml Object

title Crypto Analyzer - Concrete Runtime Object Instance Diagram

object "bitcoinAsset : CryptoAsset" as btc {
  id = "bitcoin"
  name = "Bitcoin"
  symbol = "BTC"
  market_cap_rank = 1
  image = "https://assets.coingecko.com/.../bitcoin.png"
}

object "btcMarketData : MarketData" as btcMarket {
  current_price_usd = 67850.00
  high_24h_usd = 68400.00
  low_24h_usd = 66200.00
  market_cap_usd = 1335000000000
  price_change_percentage_24h = +3.42
}

object "btcChartConfig : Chart" as chartObj {
  type = "line"
  label = "USD"
  borderColor = "#22d3ee"
  tension = 0.4
  dataPointsCount = 365
}

object "btcTrendForecast : TrendProjection" as btcTrend {
  lastPrice = 67850.00
  ma7 = 67200.00
  ma365 = 58400.00
  shift = 1257.14
  projectedPrice = 69107.14
  volatilityGap = "15.1%"

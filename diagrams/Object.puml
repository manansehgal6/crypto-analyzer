  marketShift = "Expansion"
}

object "userSimulation : PnLSimulation" as pnlSim {
  buyPrice = 50000.00
  sellPrice = 68000.00
  investment = 1000.00
  feePercent = 0.10
  unitsAcquired = 0.01998
  grossExitValue = 1358.64
  netExitValue = 1357.28
  totalFees = 2.36
  netPnl = +357.28
  roi = +35.73%
  statusBadge = "Net Profit"
}

object "intelArticle : NewsArticle" as newsItem {
  feedTitle = "Bitcoin.com"
  title = "Institutional Bitcoin Inflows Surge Past Highs"
  link = "https://news.bitcoin.com/institutional-inflows-surge"
  pubDate = "2026-11-16"
  thumbnail = "https://.../btc-news.jpg"
}

btc --> btcMarket : provides current metrics
btc --> chartObj : visualizes 365d prices
btc --> btcTrend : analyzed by Moving Averages
pnlSim ..> btc : simulates holding
@enduml
